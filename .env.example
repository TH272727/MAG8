# --- Auth for real pipeline runs (one of the two) ---
# Option A: Claude API key — per-token billing to your API account.
ANTHROPIC_API_KEY=
# Option B: Claude subscription (Pro/Max) — no API billing; runs draw on your
# plan's usage limits. Nothing to set if this machine has a logged-in Claude
# Code CLI (detected automatically). On a server, mint a long-lived token with
# `claude setup-token` and set it here:
# CLAUDE_CODE_OAUTH_TOKEN=
# Detection override: `subscription` asserts subscription auth when it can't be
# seen on disk (e.g. macOS Keychain); `disabled` blocks real runs entirely.
# MAG8_AUTH_MODE=subscription

# --- Required to trigger runs from /admin in production ---
# Any long random string. In development, admin access is open when this is unset.
ADMIN_TOKEN=

# --- Optional overrides (defaults shown) ---
# MAG8_DISCOVERY_MODEL=claude-opus-4-8
# MAG8_LENS_MODEL=claude-sonnet-5
# MAG8_COMPILER_MODEL=claude-opus-4-8
# MAG8_MAX_CONCURRENT_STOCKS=3
# MAG8_DB_PATH=./db/mag8.db
# MAG8_DISCOVERY_TIMEOUT_MS=720000
# MAG8_LENS_TIMEOUT_MS=480000
# MAG8_COMPILE_TIMEOUT_MS=360000
# MAG8_RUN_TIMEOUT_MS=2700000
# MAG8_MOCK_SPEED=1
# Allow zero-spend mock runs on a production/staging deployment (dev always allows them).
# MAG8_ALLOW_MOCK=1
