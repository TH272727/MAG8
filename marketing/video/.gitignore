node_modules/
out/
.remotion/
# generated by `npm run gen:score` — 20+ MB, fully reproducible
public/audio/
# generated by `marketing/manim/render.py` — hundreds of PNG frames per scene,
# fully reproducible from the scene file, ~12 MB each
public/manim/

# Chart-film music. The owner's licensed source videos and the audio extracted
# from them — large binaries, and licensed material that does not belong in the
# repo. `music/library.json` and `music/assignments.json` ARE committed: they
# are what makes the scoring reproducible (which excerpt, and which film got
# which track), and re-extracting from the same sources rebuilds the rest.
music/sources/
music/*.m4a
